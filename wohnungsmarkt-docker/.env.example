# ============================================================
#  Zugangsdaten für das Docker-Setup
#
#  So benutzt du diese Datei:
#    1. Kopiere sie zu einer Datei namens  .env
#       (Windows: einfach Kopie anlegen und in .env umbenennen)
#    2. Trage unten deine eigenen Passwörter ein.
#    3. Die Datei .env NICHT weitergeben und NICHT auf GitHub hochladen.
#       Dafür gibt es die .gitignore.
# ============================================================

# --- Datenbank ---
DB_USER=postgres
DB_PASSWORT=mein_sicheres_passwort
DB_NAME=wohnungsmarkt_db

# --- pgAdmin (Login für die Oberfläche im Browser) ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORT=mein_pgadmin_passwort
